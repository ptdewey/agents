{
  "title": "Coding agents — usage & spend (v2)",
  "uid": "coding-agents-v2",
  "tags": ["pi", "claude-code", "cost", "v2"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "graphTooltip": 1,
  "editable": true,
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "refresh": 2,
        "query": "label_values({__name__=~\"pi_tokens_total|claude_code_token_usage_tokens_total\"}, model)",
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      },
      {
        "name": "service",
        "label": "Source",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "refresh": 2,
        "query": "label_values({__name__=~\"pi_tokens_total|claude_code_token_usage_tokens_total\"}, service_name)",
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "row", "id": 100, "title": "How much did I spend in this window?",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false, "panels": []
    },
    {
      "id": 1, "type": "stat", "title": "Spend (window)",
      "description": "Total cost across all sources during the selected time range. Follows the time picker.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 2, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green" }] }, "noValue": "$0.00" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "(sum(increase(pi_cost_usd_total{type=\"total\",model=~\"$model\",service_name=~\"$service\"}[$__range])) or on() vector(0)) + (sum(increase(claude_code_cost_usage_USD_total{model=~\"$model\",service_name=~\"$service\"}[$__range])) or on() vector(0))" }
      ]
    },
    {
      "id": 2, "type": "stat", "title": "Billable tokens (window)",
      "description": "input + output + cacheCreation + cache_write + reasoning. cacheRead is excluded and shown separately — it's billed at ~10% of input price.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "noValue": "0" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "(sum(increase(pi_tokens_total{type=~\"input|output|cache_write|reasoning\",model=~\"$model\",service_name=~\"$service\"}[$__range])) or on() vector(0)) + (sum(increase(claude_code_token_usage_tokens_total{type=~\"input|output|cacheCreation\",model=~\"$model\",service_name=~\"$service\"}[$__range])) or on() vector(0))" }
      ]
    },
    {
      "id": 3, "type": "stat", "title": "Cache-read tokens (window)",
      "description": "Tokens served from prompt cache. Cheap, and a higher number is generally good (context reuse).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "noValue": "0" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "(sum(increase(pi_tokens_total{type=\"cache_read\",model=~\"$model\",service_name=~\"$service\"}[$__range])) or on() vector(0)) + (sum(increase(claude_code_token_usage_tokens_total{type=\"cacheRead\",model=~\"$model\",service_name=~\"$service\"}[$__range])) or on() vector(0))" }
      ]
    },
    {
      "id": 4, "type": "stat", "title": "Cache hit ratio (window)",
      "description": "cacheRead / (cacheRead + new input). Higher = more context reuse. Above 80% is typical for back-and-forth chat; below 50% suggests cache-busting flows.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1, "min": 0, "max": 1, "noValue": "N/A", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red" }, { "color": "yellow", "value": 0.5 }, { "color": "green", "value": 0.8 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [
        { "refId": "A", "expr": "((sum(increase(pi_tokens_total{type=\"cache_read\",model=~\"$model\",service_name=~\"$service\"}[$__range])) or on() vector(0)) + (sum(increase(claude_code_token_usage_tokens_total{type=\"cacheRead\",model=~\"$model\",service_name=~\"$service\"}[$__range])) or on() vector(0))) / ((sum(increase(pi_tokens_total{type=~\"cache_read|input\",model=~\"$model\",service_name=~\"$service\"}[$__range])) or on() vector(0)) + (sum(increase(claude_code_token_usage_tokens_total{type=~\"cacheRead|input\",model=~\"$model\",service_name=~\"$service\"}[$__range])) or on() vector(0)))" }
      ]
    },

    {
      "type": "row", "id": 200, "title": "Spend over time",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "collapsed": false, "panels": []
    },
    {
      "id": 10, "type": "timeseries", "title": "Lifetime cumulative spend by source",
      "description": "Raw counter values — each line is the running total since the collector started. The *slope* is what you're currently spending; flat = idle. For window-specific totals, see the headline stat or the per-interval bar chart below.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 7 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 3, "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 10, "stacking": { "mode": "none" } } } },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "pi",     "expr": "sum by (service_name) (pi_cost_usd_total{type=\"total\",model=~\"$model\",service_name=~\"$service\"})", "legendFormat": "{{service_name}}" },
        { "refId": "claude", "expr": "sum by (service_name) (claude_code_cost_usage_USD_total{model=~\"$model\",service_name=~\"$service\"})", "legendFormat": "{{service_name}}" }
      ]
    },
    {
      "id": 11, "type": "barchart", "title": "Spend by model (window)",
      "description": "Total spend per model over the selected window. Sorted descending — top of the list is where the money goes.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 7 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 3, "color": { "mode": "palette-classic-by-name" } } },
      "options": { "orientation": "horizontal", "xTickLabelRotation": 0, "showValue": "auto", "stacking": "none", "legend": { "showLegend": false }, "tooltip": { "mode": "single" }, "xField": "model", "colorByField": "model" },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true } } },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "Value", "desc": true }] } }
      ],
      "targets": [
        { "refId": "A", "expr": "sum by (model) ((increase(pi_cost_usd_total{type=\"total\",model=~\"$model\",service_name=~\"$service\"}[$__range])) or (increase(claude_code_cost_usage_USD_total{model=~\"$model\",service_name=~\"$service\"}[$__range])))", "instant": true, "format": "table" }
      ]
    },
    {
      "id": 12, "type": "timeseries", "title": "Spend per interval by source",
      "description": "Each bar is one interval of spend (interval auto-sized to the window). Bars never overlap, so the legend 'Total' = actual spend in this window.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 16 },
      "interval": "1m",
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 3, "custom": { "drawStyle": "bars", "fillOpacity": 80, "stacking": { "mode": "normal" } } } },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "pi",     "expr": "sum by (service_name) (increase(pi_cost_usd_total{type=\"total\",model=~\"$model\",service_name=~\"$service\"}[$__interval]))", "legendFormat": "{{service_name}}" },
        { "refId": "claude", "expr": "sum by (service_name) (increase(claude_code_cost_usage_USD_total{model=~\"$model\",service_name=~\"$service\"}[$__interval]))", "legendFormat": "{{service_name}}" }
      ]
    },
    {
      "id": 13, "type": "timeseries", "title": "Sub-agent vs main thread spend (Claude Code)",
      "description": "Claude Code splits cost by query_source: main (your prompts) vs auxiliary/subagent (delegated to sub-agents). Useful for spotting expensive delegation patterns. Bars are non-overlapping, so legend Total = window total.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 16 },
      "interval": "1m",
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 3, "custom": { "drawStyle": "bars", "fillOpacity": 80, "stacking": { "mode": "normal" } } } },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (query_source) (increase(claude_code_cost_usage_USD_total{model=~\"$model\",service_name=~\"$service\"}[$__interval]))", "legendFormat": "{{query_source}}" }
      ]
    },

    {
      "type": "row", "id": 300, "title": "Tokens",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "collapsed": false, "panels": []
    },
    {
      "id": 20, "type": "timeseries", "title": "Token volume by type over time",
      "description": "Stacked tokens-per-interval. cacheRead is usually the dominant bar (good — it's cheap). cacheCreation spikes when a new context is established. reasoning shows extended-thinking burn. pi's cache_read/cache_write are normalized to cacheRead/cacheCreation.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 10, "w": 16, "x": 0, "y": 26 },
      "interval": "1m",
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 80, "stacking": { "mode": "normal" } } }, "overrides": [
        { "matcher": { "id": "byName", "options": "cacheRead" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#37872d" } }] },
        { "matcher": { "id": "byName", "options": "input" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#1f60c4" } }] },
        { "matcher": { "id": "byName", "options": "output" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#fa6400" } }] },
        { "matcher": { "id": "byName", "options": "cacheCreation" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#b877d9" } }] },
        { "matcher": { "id": "byName", "options": "reasoning" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#e02f44" } }] }
      ] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (type) ((label_replace(label_replace(increase(pi_tokens_total{type!=\"total\",model=~\"$model\",service_name=~\"$service\"}[$__interval]), \"type\", \"cacheRead\", \"type\", \"cache_read\"), \"type\", \"cacheCreation\", \"type\", \"cache_write\")) or (increase(claude_code_token_usage_tokens_total{model=~\"$model\",service_name=~\"$service\"}[$__interval])))", "legendFormat": "{{type}}" }
      ]
    },
    {
      "id": 21, "type": "piechart", "title": "Token mix (window)",
      "description": "Share of total tokens by type across the window. Quick read on where context is going.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 10, "w": 8, "x": 16, "y": 26 },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "pieType": "donut", "tooltip": { "mode": "single" }, "legend": { "displayMode": "table", "placement": "right", "values": ["percent"] } },
      "targets": [
        { "refId": "A", "expr": "sum by (type) ((label_replace(label_replace(increase(pi_tokens_total{type!=\"total\",model=~\"$model\",service_name=~\"$service\"}[$__range]), \"type\", \"cacheRead\", \"type\", \"cache_read\"), \"type\", \"cacheCreation\", \"type\", \"cache_write\")) or (increase(claude_code_token_usage_tokens_total{model=~\"$model\",service_name=~\"$service\"}[$__range])))", "instant": true, "legendFormat": "{{type}}" }
      ]
    },

    {
      "type": "row", "id": 400, "title": "Efficiency",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "collapsed": false, "panels": []
    },
    {
      "id": 30, "type": "table", "title": "Cost per 1k output tokens by model (window)",
      "description": "How much did you actually pay per 1k tokens of real model output? Lower is better. Big variance vs the published price hints at reasoning overhead or cache-creation tax.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 37 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4, "custom": { "align": "auto" } } },
      "options": { "showHeader": true },
      "transformations": [
        { "id": "merge" },
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "Value": "$/1k output tokens" } } },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "$/1k output tokens", "desc": true }] } }
      ],
      "targets": [
        { "refId": "pi",     "expr": "sum by (model) (increase(pi_cost_usd_total{type=\"total\",model=~\"$model\",service_name=~\"$service\"}[$__range])) / (sum by (model) (increase(pi_tokens_total{type=\"output\",model=~\"$model\",service_name=~\"$service\"}[$__range])) / 1000)", "instant": true, "format": "table" },
        { "refId": "claude", "expr": "sum by (model) (increase(claude_code_cost_usage_USD_total{model=~\"$model\",service_name=~\"$service\"}[$__range])) / (sum by (model) (increase(claude_code_token_usage_tokens_total{type=\"output\",model=~\"$model\",service_name=~\"$service\"}[$__range])) / 1000)", "instant": true, "format": "table" }
      ]
    },
    {
      "id": 31, "type": "stat", "title": "Cost per active minute (Claude Code)",
      "description": "Spend divided by Claude Code's reported active time. Approximate but useful — a high number means each minute in the terminal is expensive.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 37 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 3, "noValue": "N/A" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "expr": "(sum(increase(claude_code_cost_usage_USD_total{model=~\"$model\",service_name=~\"$service\"}[$__range]))) / (sum(increase(claude_code_active_time_seconds_total{service_name=~\"$service\"}[$__range])) / 60)" }
      ]
    },
    {
      "id": 32, "type": "stat", "title": "Edit accept rate (Claude Code)",
      "description": "Fraction of edit-tool decisions where you accepted the proposed change. Currently emits 'accept' only — if rejection events appear in your data this will become meaningful as a ratio.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 37 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1, "min": 0, "max": 1, "noValue": "N/A", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red" }, { "color": "yellow", "value": 0.5 }, { "color": "green", "value": 0.8 }] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "targets": [
        { "refId": "A", "expr": "sum(increase(claude_code_code_edit_tool_decision_total{decision=\"accept\",service_name=~\"$service\"}[$__range])) / sum(increase(claude_code_code_edit_tool_decision_total{service_name=~\"$service\"}[$__range]))" }
      ]
    },

    {
      "type": "row", "id": 500, "title": "Activity & tools",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 46 },
      "collapsed": false, "panels": []
    },
    {
      "id": 41, "type": "barchart", "title": "Top tools by execution count (window, pi)",
      "description": "Which tools the pi agent reaches for most. Helps validate that the workload looks like what you expect.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 47 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "palette-classic-by-name" } } },
      "options": { "orientation": "horizontal", "showValue": "auto", "legend": { "showLegend": false }, "tooltip": { "mode": "single" }, "xField": "tool", "colorByField": "tool" },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true } } },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "Value", "desc": true }] } }
      ],
      "targets": [
        { "refId": "A", "expr": "topk(15, sum by (tool) (increase(pi_tool_executions_total{service_name=~\"$service\"}[$__range])))", "instant": true, "format": "table" }
      ]
    },
    {
      "id": 42, "type": "table", "title": "Tool performance (window, pi)",
      "description": "Per-tool: how many times, how slow (p50/p95). High p95 on a frequently-used tool is where latency budget goes.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 54 },
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [
        { "matcher": { "id": "byRegexp", "options": "p50|p95" }, "properties": [{ "id": "unit", "value": "s" }, { "id": "decimals", "value": 2 }] },
        { "matcher": { "id": "byName", "options": "count" }, "properties": [{ "id": "unit", "value": "short" }, { "id": "decimals", "value": 0 }] }
      ] },
      "options": { "showHeader": true },
      "transformations": [
        { "id": "merge" },
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "Value #count": "count", "Value #p50": "p50", "Value #p95": "p95" } } },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "count", "desc": true }] } }
      ],
      "targets": [
        { "refId": "count", "expr": "sum by (tool) (increase(pi_tool_executions_total{service_name=~\"$service\"}[$__range]))", "instant": true, "format": "table" },
        { "refId": "p50",   "expr": "histogram_quantile(0.50, sum by (le, tool) (rate(pi_tool_duration_seconds_bucket{service_name=~\"$service\"}[$__range])))", "instant": true, "format": "table" },
        { "refId": "p95",   "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(pi_tool_duration_seconds_bucket{service_name=~\"$service\"}[$__range])))", "instant": true, "format": "table" }
      ]
    },
    {
      "id": 43, "type": "timeseries", "title": "Lines of code added vs removed (Claude Code)",
      "description": "Edit throughput, split by direction. Big removed spikes can be cleanups or migrations; ratio gives a feel for the kind of work you're doing.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 54 },
      "interval": "1m",
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 80, "stacking": { "mode": "normal" } } }, "overrides": [
        { "matcher": { "id": "byName", "options": "added" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
        { "matcher": { "id": "byName", "options": "removed" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
      ] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sum by (type) (increase(claude_code_lines_of_code_count_total{service_name=~\"$service\"}[$__interval]))", "legendFormat": "{{type}}" }
      ]
    },

    {
      "type": "row", "id": 600, "title": "Provider rollup",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 63 },
      "collapsed": false, "panels": []
    },
    {
      "id": 50, "type": "barchart", "title": "Spend share by provider (window)",
      "description": "Cost grouped by provider, inferred from the model name. 'other' = a model that didn't match the regex.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 64 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 3, "color": { "mode": "palette-classic-by-name" } } },
      "options": { "orientation": "horizontal", "showValue": "auto", "stacking": "none", "legend": { "showLegend": false }, "tooltip": { "mode": "single" }, "xField": "provider", "colorByField": "provider" },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true } } },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "Value", "desc": true }] } }
      ],
      "targets": [
